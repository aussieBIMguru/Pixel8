          "text": "+20 gold, but the shrine notices",
          "success": [
            {
              "type": "gold",
              "amount": "20"
            },
            {
              "type": "luck",
              "amount": "-1"
            }
          ]
        },
        {
          "label": "Leave",
          "text": "Walk on"
        }
      ]
    },

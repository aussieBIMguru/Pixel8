<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standalone app (MonoGame DesktopGL: Windows/macOS/Linux). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <RootNamespace>Pixel8.Desktop</RootNamespace>
    <AssemblyName>Pixel8</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <!-- Add when real art/audio arrives (M3+):
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixel8.Core\Pixel8.Core.csproj" />
  </ItemGroup>

</Project>

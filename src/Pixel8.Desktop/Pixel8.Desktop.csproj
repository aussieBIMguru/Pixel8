<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standalone app (MonoGame DesktopGL: Windows/macOS/Linux). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <RootNamespace>Pixel8.Desktop</RootNamespace>
    <AssemblyName>Pixel8</AssemblyName>
    <!-- Pixelated "8" icon: the .exe icon on Windows. -->
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- MonoGame DesktopGL loads the window/taskbar icon from these embedded resources (same as its project template). -->
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <!-- Add when real art/audio arrives (M3+):
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.2.1105" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
    -->
  </ItemGroup>

  <!-- Ship the JSON content next to the exe (ContentDb.FindDataDirectory checks the exe folder first). -->
  <ItemGroup>
    <None Include="..\..\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Round 9: music tracks (text, rendered by the chip synth at startup). -->
    <None Include="..\..\data\music\*.mml" Link="data\music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Licence files ship next to Pixel8.exe (and in the installer). -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixel8.Core\Pixel8.Core.csproj" />
  </ItemGroup>

</Project>
